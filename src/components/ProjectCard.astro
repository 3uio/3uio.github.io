---
interface Props {
  number: string;
  title: string;
  description: string;
  type: string;
  tags: string[];
  status: string;
  github?: string;
  paper?: string;
  demo?: string;
}

const { number, title, description, type, tags, status, github, paper, demo } = Astro.props;
const links = [
  github && { href: github, label: 'Code' },
  paper && { href: paper, label: 'Paper' },
  demo && { href: demo, label: 'Demo' },
].filter(Boolean) as { href: string; label: string }[];
---

<article class="project-card">
  <div class="project-meta">
    <span>{number}</span>
    <span class="status">{status}</span>
  </div>
  <div class="project-body">
    <p class="project-type">{type}</p>
    <h3>{title}</h3>
    <p class="project-description">{description}</p>
    <ul class="tag-list" aria-label={`${title} 技术标签`}>
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
  <div class="project-links">
    {links.length > 0 ? links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
    )) : <span>No public link</span>}
  </div>
</article>

<style>
  .project-card {
    display: grid;
    min-height: 360px;
    grid-template-rows: auto 1fr auto;
    padding: 27px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .project-card:hover { border-color: #b8cbd9; box-shadow: var(--shadow-md); transform: translateY(-5px); }
  .project-meta { display: flex; align-items: center; justify-content: space-between; color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.72rem; }
  .project-body { padding: 52px 0 34px; }
  .project-type { margin-bottom: 10px; color: var(--accent-strong); font-size: 0.78rem; font-weight: 730; letter-spacing: 0.04em; text-transform: uppercase; }
  h3 { margin-bottom: 16px; font-size: clamp(1.35rem, 3vw, 1.75rem); font-weight: 720; }
  .project-description { margin-bottom: 24px; color: var(--ink-soft); font-size: 0.95rem; }
  .project-links { display: flex; flex-wrap: wrap; gap: 16px; padding-top: 18px; border-top: 1px solid var(--line); }
  .project-links a { color: var(--accent-strong); font-size: 0.8rem; font-weight: 720; text-decoration: none; transition: transform 180ms ease, color 180ms ease; }
  .project-links a:hover { color: var(--accent); transform: translateX(3px); }
  .project-links span { color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.68rem; }
</style>

---
interface Props {
  index: string;
  title: string;
  subtitle: string;
  description: string;
  topics: string[];
}

const { index, title, subtitle, description, topics } = Astro.props;
---

<article class="research-card">
  <div class="card-top">
    <span class="card-index">{index}</span>
    <span class="card-arrow" aria-hidden="true">↗</span>
  </div>
  <h3>{title}</h3>
  <p class="subtitle">{subtitle}</p>
  <p class="description">{description}</p>
  <ul class="tag-list" aria-label={`${title} 相关主题`}>
    {topics.map((topic) => <li class="tag">{topic}</li>)}
  </ul>
</article>

<style>
  .research-card {
    position: relative;
    overflow: hidden;
    min-height: 320px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.84);
    box-shadow: var(--shadow-sm);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .research-card::after {
    position: absolute;
    right: -50px;
    bottom: -70px;
    width: 150px;
    height: 150px;
    border: 1px solid rgba(23, 107, 135, 0.12);
    border-radius: 50%;
    content: "";
    box-shadow: 0 0 0 24px rgba(23, 107, 135, 0.035), 0 0 0 48px rgba(23, 107, 135, 0.02);
  }

  .research-card:hover {
    z-index: 1;
    border-color: #b8cbd9;
    box-shadow: var(--shadow-md);
    transform: translateY(-5px);
  }

  .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 48px; }
  .card-index { color: var(--accent); font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; }
  .card-arrow { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--ink-soft); }
  h3 { margin-bottom: 7px; font-size: 1.35rem; font-weight: 720; }
  .subtitle { margin-bottom: 19px; color: var(--accent-strong); font-size: 0.84rem; font-weight: 700; }
  .description { position: relative; z-index: 1; margin-bottom: 24px; color: var(--ink-soft); font-size: 0.94rem; }
  .tag-list { position: relative; z-index: 1; }
</style>

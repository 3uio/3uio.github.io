---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  linkHref?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, linkHref, linkLabel = '查看全部' } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {linkHref && <a class="text-link" href={linkHref}>{linkLabel}<span aria-hidden="true">→</span></a>}
</div>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 38px;
  }

  h2 {
    max-width: 750px;
    margin-bottom: 0;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 710;
  }

  .section-description {
    max-width: 690px;
    margin: 15px 0 0;
    color: var(--ink-soft);
    font-size: 1.02rem;
  }

  .text-link { flex: none; margin-bottom: 6px; }

  @media (max-width: 640px) {
    .section-heading { align-items: flex-start; flex-direction: column; gap: 18px; }
  }
</style>

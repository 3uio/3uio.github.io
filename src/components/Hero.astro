---
import { profile } from '../data/site';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <p class="hero-kicker"><span aria-hidden="true"></span> CS Student · Research Explorer</p>
      <h1>Learning to build<br /><em>reliable intelligence.</em></h1>
      <p class="hero-cn">在代码、模型与可信数字世界之间持续探索。</p>
      <p class="hero-description">{profile.description}</p>
      <div class="button-row">
        <a class="button button-primary" href="/research/">Explore Research <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-footnote">
        <span class="status">OPEN TO LEARNING</span>
        <span>Based in the digital world</span>
      </div>
    </div>

    <div class="hero-visual reveal reveal-delay" aria-label="3uio 个人资料">
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="avatar-frame">
        <img src={profile.avatar} alt="3uio 的 GitHub 头像" width="400" height="400" fetchpriority="high" />
      </div>
      <div class="identity-card">
        <span class="identity-label">IDENTITY / 001</span>
        <strong>{profile.handle}</strong>
        <span>{profile.role}</span>
      </div>
      <div class="focus-card">
        <span>FOCUS</span>
        <strong>AI · DL · SECURITY</strong>
      </div>
      <span class="coordinate coordinate-one">31.2304° N</span>
      <span class="coordinate coordinate-two">121.4737° E</span>
    </div>
  </div>
</section>

<style>
  .hero { overflow: hidden; padding: 84px 0 102px; }
  .hero-grid { display: grid; min-height: 610px; grid-template-columns: minmax(0, 1.15fr) minmax(380px, 0.85fr); align-items: center; gap: 52px; }
  .hero-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; color: var(--accent-strong); font-family: var(--font-mono); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.12em; }
  .hero-kicker span { width: 8px; height: 8px; border-radius: 50%; background: #2d9b8f; box-shadow: 0 0 0 5px rgba(45, 155, 143, 0.12); }
  h1 { max-width: 760px; margin-bottom: 22px; color: var(--navy); font-size: clamp(3.3rem, 6.4vw, 6rem); font-weight: 740; line-height: 0.98; letter-spacing: -0.065em; }
  h1 em { color: var(--accent); font-family: Georgia, "Times New Roman", serif; font-weight: 500; letter-spacing: -0.055em; }
  .hero-cn { margin-bottom: 16px; color: var(--ink); font-size: clamp(1.1rem, 2vw, 1.35rem); font-weight: 650; letter-spacing: -0.02em; }
  .hero-description { max-width: 630px; margin-bottom: 31px; color: var(--ink-soft); font-size: 1rem; }
  .hero-footnote { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 52px; color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.68rem; }
  .hero-visual { position: relative; min-height: 520px; }
  .avatar-frame { position: absolute; top: 72px; left: 50%; z-index: 3; overflow: hidden; width: 300px; height: 300px; border: 12px solid rgba(255, 255, 255, 0.8); border-radius: 42% 58% 52% 48% / 44% 44% 56% 56%; background: var(--surface-soft); box-shadow: var(--shadow-md); transform: translateX(-50%); }
  .avatar-frame img { width: 100%; height: 100%; object-fit: cover; }
  .orbit { position: absolute; top: 42px; left: 50%; border: 1px solid rgba(23, 107, 135, 0.18); border-radius: 50%; transform: translateX(-50%); }
  .orbit::before { position: absolute; top: 12%; left: 4%; width: 10px; height: 10px; border: 3px solid var(--bg); border-radius: 50%; content: ""; background: var(--warm); }
  .orbit-one { width: 390px; height: 390px; }
  .orbit-two { top: 8px; width: 458px; height: 458px; border-style: dashed; opacity: 0.68; }
  .identity-card,
  .focus-card { position: absolute; z-index: 5; padding: 15px 17px; border: 1px solid rgba(203, 216, 230, 0.92); border-radius: 15px; background: rgba(255, 255, 255, 0.88); box-shadow: var(--shadow-sm); backdrop-filter: blur(12px); }
  .identity-card { right: -10px; bottom: 78px; display: grid; min-width: 190px; }
  .identity-label,
  .focus-card span { color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.61rem; letter-spacing: 0.08em; }
  .identity-card strong { margin-top: 5px; font-size: 1.15rem; }
  .identity-card > span:last-child { color: var(--ink-soft); font-size: 0.75rem; }
  .focus-card { bottom: 142px; left: -8px; display: grid; }
  .focus-card strong { margin-top: 4px; color: var(--accent-strong); font-family: var(--font-mono); font-size: 0.68rem; }
  .coordinate { position: absolute; color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.08em; }
  .coordinate-one { top: 16px; right: 20px; }
  .coordinate-two { bottom: 24px; left: 32px; }

  @media (max-width: 960px) {
    .hero { padding-top: 60px; }
    .hero-grid { min-height: auto; grid-template-columns: 1fr; }
    .hero-visual { width: min(100%, 520px); min-height: 500px; margin-inline: auto; }
  }

  @media (max-width: 540px) {
    .hero { padding: 48px 0 70px; }
    .hero-grid { gap: 35px; }
    h1 { font-size: clamp(3.05rem, 16vw, 4.35rem); }
    .hero-visual { min-height: 410px; transform: scale(0.88); transform-origin: top center; margin-bottom: -50px; }
    .avatar-frame { width: 250px; height: 250px; }
    .orbit-one { width: 325px; height: 325px; }
    .orbit-two { width: 380px; height: 380px; }
    .identity-card { right: -18px; bottom: 47px; }
    .focus-card { bottom: 103px; left: -12px; }
  }
</style>

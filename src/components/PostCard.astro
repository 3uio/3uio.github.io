---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const date = post.data.publishedAt.toLocaleDateString('zh-CN', {
  year: 'numeric', month: '2-digit', day: '2-digit',
});
---

<article class:list={['post-card', { compact }]}>
  <div class="post-meta">
    <time datetime={post.data.publishedAt.toISOString()}>{date}</time>
    <span>{post.data.category}</span>
    {post.data.isExample && <span class="example-label">示例内容</span>}
  </div>
  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="post-bottom">
    <ul class="tag-list" aria-label="文章标签">
      {post.data.tags.slice(0, 3).map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <a class="read-link" href={`/blog/${post.id}/`} aria-label={`阅读 ${post.data.title}`}>Read <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .post-card {
    display: grid;
    min-height: 288px;
    grid-template-rows: auto auto 1fr auto;
    padding: 25px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.85);
    box-shadow: var(--shadow-sm);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .post-card:hover { border-color: #b8cbd9; box-shadow: var(--shadow-md); transform: translateY(-4px); }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-bottom: 34px; color: var(--ink-faint); font-family: var(--font-mono); font-size: 0.68rem; }
  .example-label { padding: 4px 7px; border-radius: 999px; color: #8b4c34; background: #f7e8df; font-weight: 700; }
  h3 { margin-bottom: 13px; font-size: 1.24rem; font-weight: 720; }
  h3 a { text-decoration: none; }
  h3 a::after { position: absolute; inset: 0; content: ""; }
  p { margin-bottom: 24px; color: var(--ink-soft); font-size: 0.9rem; }
  .post-card { position: relative; }
  .post-bottom { display: flex; align-items: end; justify-content: space-between; gap: 16px; }
  .read-link { position: relative; z-index: 2; flex: none; color: var(--accent-strong); font-size: 0.78rem; font-weight: 750; text-decoration: none; }
  .read-link span { display: inline-block; transition: transform 180ms ease; }
  .post-card:hover .read-link span { transform: translateX(4px); }
  .compact { min-height: 260px; }
</style>

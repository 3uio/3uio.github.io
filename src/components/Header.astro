---
import { navLinks } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="header-inner container">
    <a class="brand" href="/" aria-label="3uio 首页">
      <img class="brand-mark" src="/favicon.svg" width="34" height="34" alt="" aria-hidden="true" />
      <span class="brand-text">3uio<span class="brand-dot">.</span></span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navLinks.map((link) => (
        <a class:list={{ active: isActive(link.href) }} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <a class="header-contact" href="/contact/">Contact <span aria-hidden="true">↗</span></a>

    <details class="mobile-menu">
      <summary role="button" aria-label="打开导航菜单" aria-expanded="false"><span></span><span></span></summary>
      <nav aria-label="移动端导航">
        {navLinks.map((link) => (
          <a class:list={{ active: isActive(link.href) }} href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a href="/contact/">Contact</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(203, 216, 230, 0.72);
    background: rgba(244, 247, 251, 0.82);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    display: grid;
    min-height: 70px;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    flex: none;
    filter: drop-shadow(0 8px 12px rgba(11, 32, 56, 0.16));
    transition: transform 180ms ease;
  }

  .brand:hover .brand-mark {
    transform: rotate(-4deg) scale(1.04);
  }

  .brand-text {
    color: var(--ink);
    font-size: 1.08rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .brand-dot {
    color: var(--warm);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .desktop-nav a {
    position: relative;
    padding: 9px 12px;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.83rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 160ms ease, background 160ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.72);
  }

  .desktop-nav a.active::after {
    position: absolute;
    right: 12px;
    bottom: 4px;
    left: 12px;
    height: 2px;
    border-radius: 2px;
    content: "";
    background: var(--accent);
  }

  .header-contact {
    justify-self: end;
    color: var(--accent-strong);
    font-size: 0.83rem;
    font-weight: 750;
    text-decoration: none;
  }

  .mobile-menu {
    display: none;
    justify-self: end;
  }

  .mobile-menu summary {
    display: grid;
    width: 42px;
    height: 42px;
    cursor: pointer;
    list-style: none;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu summary span { display: block; width: 17px; height: 1.5px; background: var(--ink); transition: transform 180ms ease; }
  .mobile-menu[open] summary span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .mobile-menu[open] summary span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 8px);
    right: 14px;
    left: 14px;
    display: grid;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: var(--shadow-md);
  }

  .mobile-menu nav a {
    padding: 11px 13px;
    border-radius: 10px;
    color: var(--ink-soft);
    font-weight: 680;
    text-decoration: none;
  }

  .mobile-menu nav a.active,
  .mobile-menu nav a:hover { color: var(--ink); background: var(--surface-soft); }

  @media (max-width: 820px) {
    .header-inner { display: flex; justify-content: space-between; }
    .desktop-nav,
    .header-contact { display: none; }
    .mobile-menu { display: block; }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  const summary = menu?.querySelector('summary');
  if (menu && summary) {
    const syncLabel = () => {
      summary.setAttribute('aria-label', menu.open ? '关闭导航菜单' : '打开导航菜单');
      summary.setAttribute('aria-expanded', String(menu.open));
    };
    menu.addEventListener('toggle', syncLabel);
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => menu.removeAttribute('open')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.removeAttribute('open');
        summary.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.removeAttribute('open');
    });
  }
</script>

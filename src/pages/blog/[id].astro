---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedAt = post.data.publishedAt.toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Layout title={`${post.data.title} · 3uio`} description={post.data.description} article>
  <article class="article-shell">
    <header class="article-header narrow-container reveal">
      <a class="back-link" href="/blog/"><span aria-hidden="true">←</span> Back to Blog</a>
      <div class="article-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
        <span>{post.data.category}</span>
        {post.data.isExample && <span class="example-label">示例 / Placeholder</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <ul class="tag-list" aria-label="文章标签">
        {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    </header>

    {post.data.isExample && (
      <div class="narrow-container example-banner">
        <strong>示例内容说明</strong>
        <span>此文章用于验证 Blog 页面与 Markdown 样式，不是作者真实经历或科研成果。</span>
      </div>
    )}

    <div class="article-content narrow-container">
      <Content />
    </div>

    <footer class="article-footer narrow-container">
      <div>
        <span>END OF NOTE</span>
        <strong>继续记录，持续校正。</strong>
      </div>
      <a class="button button-secondary" href="/blog/">返回全部文章</a>
    </footer>
  </article>
</Layout>

<style>
  .article-shell { padding: 72px 0 110px; }
  .article-header { padding-bottom: 54px; border-bottom: 1px solid var(--line-strong); }
  .back-link { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 58px; color: var(--accent-strong); font-size: .8rem; font-weight: 700; text-decoration: none; }
  .article-meta { display: flex; flex-wrap: wrap; gap: 9px 18px; margin-bottom: 22px; color: var(--ink-faint); font-family: var(--font-mono); font-size: .7rem; }
  .example-label { padding: 3px 7px; border-radius: 999px; color: #8b4c34; background: #f7e8df; font-weight: 700; }
  h1 { margin-bottom: 22px; font-size: clamp(2.5rem, 6vw, 4.8rem); font-weight: 730; }
  .article-description { max-width: 700px; margin-bottom: 26px; color: var(--ink-soft); font-size: 1.12rem; }
  .example-banner { display: flex; align-items: center; gap: 14px; margin-top: 34px; padding: 14px 17px; border: 1px solid #e7cbbd; border-radius: 12px; color: #75442f; background: #fbf0e9; font-size: .83rem; }
  .example-banner strong { flex: none; }
  .article-content { padding-block: 58px 72px; color: #27384a; font-size: 1.01rem; }
  .article-content :global(h2) { margin: 2.3em 0 .8em; color: var(--ink); font-size: clamp(1.55rem, 3vw, 2.05rem); }
  .article-content :global(h3) { margin: 1.8em 0 .7em; color: var(--ink); font-size: 1.3rem; }
  .article-content :global(p) { margin-bottom: 1.35em; }
  .article-content :global(a) { color: var(--accent-strong); text-underline-offset: 3px; }
  .article-content :global(blockquote) { margin: 2em 0; padding: 18px 22px; border-left: 3px solid var(--warm); border-radius: 0 12px 12px 0; color: var(--ink-soft); background: #f4ebe7; }
  .article-content :global(blockquote p) { margin: 0; }
  .article-content :global(ul),
  .article-content :global(ol) { margin: 1.2em 0; padding-left: 1.4em; }
  .article-content :global(li) { margin: .45em 0; padding-left: .3em; }
  .article-content :global(code) { padding: 2px 6px; border: 1px solid var(--line); border-radius: 6px; color: #24596c; background: #edf4f7; font-family: var(--font-mono); font-size: .86em; }
  .article-content :global(pre) { overflow-x: auto; margin: 2em 0; padding: 22px; border: 1px solid #243d56; border-radius: 16px; color: #d9e7f2; background: #0e2238; box-shadow: var(--shadow-sm); }
  .article-content :global(pre code) { padding: 0; border: 0; color: inherit; background: transparent; }
  .article-content :global(table) { width: 100%; margin: 2em 0; border-collapse: collapse; font-size: .9rem; }
  .article-content :global(th),
  .article-content :global(td) { padding: 11px 14px; border: 1px solid var(--line-strong); text-align: left; }
  .article-content :global(th) { color: var(--ink); background: var(--surface-soft); }
  .article-content :global(hr) { margin: 3em 0; border: 0; border-top: 1px solid var(--line-strong); }
  .article-footer { display: flex; align-items: center; justify-content: space-between; gap: 30px; padding-top: 30px; border-top: 1px solid var(--line-strong); }
  .article-footer div { display: grid; }
  .article-footer span { color: var(--ink-faint); font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; }
  .article-footer strong { margin-top: 4px; }
  @media (max-width: 600px) {
    .article-shell { padding-top: 48px; }
    .back-link { margin-bottom: 42px; }
    .example-banner { align-items: flex-start; flex-direction: column; }
    .article-content { font-size: .96rem; }
    .article-footer { align-items: flex-start; flex-direction: column; }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, profile } from '../data/site';
---

<Layout title="Projects · 3uio" description="3uio 的公开项目：视频水印、AI Safety、Java/Swing 体素沙盒与 Astro 个人网站。">
  <div class="page-shell">
    <div class="container">
      <header class="page-heading reveal">
        <p class="eyebrow">PROJECTS / 项目</p>
        <h1>Build, test,<br />learn, document.</h1>
        <p>这里展示可公开核验的研究代码与工程实践。说明基于仓库 README 整理，不补写未公开的个人分工、比赛结果或研究结论。</p>
      </header>

      <div class="project-summary" aria-label="项目概览">
        <div><strong>{String(projects.length).padStart(2, '0')}</strong><span>SELECTED WORK</span></div>
        <p>Python / PyTorch · Java / Swing · Astro / Markdown</p>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">All repositories ↗</a>
      </div>

      <div class="grid-2 projects-grid">
        {projects.map((project) => <ProjectCard {...project} />)}
      </div>

      <aside class="project-note">
        <p class="eyebrow">ABOUT THE WORK</p>
        <h2>用公开证据描述项目，也保留清晰的边界。</h2>
        <p>项目状态会随公开仓库持续更新。CAFIW 对应公开研究代码，但本站不会在论文正式公开前自行补充作者、venue 或成果指标；SafeChat-Guard 当前明确标注为工程原型。</p>
      </aside>
    </div>
  </div>
</Layout>

<style>
  .project-summary { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px; margin-bottom: 28px; padding: 17px 20px; border-block: 1px solid var(--line-strong); }
  .project-summary div { display: grid; }
  .project-summary strong { color: var(--accent-strong); font-family: var(--font-mono); font-size: 1.35rem; line-height: 1; }
  .project-summary span, .project-summary p, .project-summary a { color: var(--ink-faint); font-family: var(--font-mono); font-size: .65rem; letter-spacing: .06em; }
  .project-summary p { margin: 0; text-align: center; }
  .project-summary a { color: var(--accent-strong); font-weight: 700; text-decoration: none; }
  .projects-grid { margin-bottom: 88px; }
  .project-note { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 22px 70px; padding: 48px; border-radius: var(--radius-lg); color: white; background: var(--navy); }
  .project-note .eyebrow { grid-column: 1 / -1; margin: 0; color: #7dc6d3; }
  .project-note h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.1rem); }
  .project-note > p:last-child { margin: 0; color: #b7c6d6; }
  @media (max-width: 720px) {
    .project-summary { grid-template-columns: auto 1fr; }
    .project-summary p { display: none; }
    .project-summary a { justify-self: end; }
    .project-note { grid-template-columns: 1fr; padding: 32px 24px; }
    .project-note .eyebrow { grid-column: auto; }
  }
</style>

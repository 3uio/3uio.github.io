---
import Layout from '../layouts/Layout.astro';
import ResearchCard from '../components/ResearchCard.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { researchAreas } from '../data/site';
---

<Layout title="Research · 3uio" description="3uio 当前关注的研究方向：Artificial Intelligence、Deep Learning、Multimedia Security 与 Digital Watermarking。">
  <div class="page-shell">
    <div class="container">
      <header class="page-heading reveal">
        <p class="eyebrow">RESEARCH / 研究方向</p>
        <h1>Questions first.<br />Methods with purpose.</h1>
        <p>从问题出发学习方法，在实验中理解边界。这里记录当前研究兴趣及未来可扩展的研究脉络。</p>
      </header>
      <div class="research-grid">
        {researchAreas.map((area) => <ResearchCard {...area} />)}
      </div>
    </div>
  </div>

  <section class="section section-tint">
    <div class="container">
      <SectionTitle
        eyebrow="RESEARCH LOGIC"
        title="从兴趣到研究问题"
        description="在真实研究经历补充之前，先以统一框架组织每个方向，避免只堆砌关键词。"
      />
      <div class="logic-grid">
        <article>
          <span>01</span>
          <h3>Problem</h3>
          <p>问题是什么？为什么重要？现有方法在哪些条件下仍然不足？</p>
        </article>
        <article>
          <span>02</span>
          <h3>Method</h3>
          <p>用什么模型、系统或实验设计回答问题？关键假设是否成立？</p>
        </article>
        <article>
          <span>03</span>
          <h3>Evidence</h3>
          <p>如何评测、复现并解释结果？失败案例又揭示了什么边界？</p>
        </article>
        <article>
          <span>04</span>
          <h3>Impact</h3>
          <p>工作能为安全、可信的智能系统或多媒体内容带来什么价值？</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container research-note">
      <div>
        <p class="eyebrow">STATUS</p>
        <h2>Research profile<br />under construction.</h2>
      </div>
      <div>
        <p>当前页面仅陈述研究兴趣与学习框架，没有声称已发表论文、获得奖项或完成特定研究成果。</p>
        <p>后续可以为每个方向补充：核心问题、阅读列表、实验记录、项目关联与代表性成果。</p>
        <a class="text-link" href="/publications/">查看 Publications 占位结构 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .research-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .logic-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--line-strong); }
  .logic-grid article { min-height: 255px; padding: 28px 25px; border-right: 1px solid var(--line-strong); }
  .logic-grid article:last-child { border-right: 0; }
  .logic-grid span { color: var(--accent); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700; }
  .logic-grid h3 { margin: 55px 0 14px; font-size: 1.25rem; }
  .logic-grid p { margin: 0; color: var(--ink-soft); font-size: 0.88rem; }
  .research-note { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }
  .research-note h2 { margin: 0; font-size: clamp(2.2rem, 4.5vw, 3.8rem); }
  .research-note > div:last-child p { color: var(--ink-soft); }
  .research-note .text-link { margin-top: 14px; }
  @media (max-width: 850px) {
    .logic-grid { grid-template-columns: 1fr 1fr; }
    .logic-grid article:nth-child(2) { border-right: 0; }
    .logic-grid article:nth-child(-n+2) { border-bottom: 1px solid var(--line-strong); }
  }
  @media (max-width: 700px) {
    .research-grid,
    .research-note { grid-template-columns: 1fr; gap: 38px; }
  }
  @media (max-width: 520px) {
    .logic-grid { grid-template-columns: 1fr; }
    .logic-grid article { min-height: auto; border-right: 0; border-bottom: 1px solid var(--line-strong); }
    .logic-grid article:nth-child(3) { border-bottom: 1px solid var(--line-strong); }
    .logic-grid article:last-child { border-bottom: 0; }
    .logic-grid h3 { margin-top: 30px; }
  }
</style>

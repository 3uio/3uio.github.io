---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = '3uio · Computer Science, AI & Research',
  description = '3uio 的个人网站：记录计算机科学、Artificial Intelligence、Deep Learning、Multimedia Security、项目与学习笔记。',
  image = 'https://github.com/3uio.png?size=400',
  article = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b2038" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="https://github.com/3uio.png?size=64" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="3uio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
